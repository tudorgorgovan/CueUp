    <DTS:Executable
      DTS:refId="Package\CHECK_ID"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9E7DC4DA-72FE-4EFF-AF59-248E0108C046}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CHECK_ID"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A93CD923-1C08-4CD2-BA93-F365BA3F44E7}"
          SQLTask:SqlStatementSource="DBCC CHECKIDENT ('dbo.Jucatori', RESEED);&#xA;DBCC CHECKIDENT ('dbo.Rezervari', RESEED);&#xA;DBCC CHECKIDENT ('dbo.Meciuri', RESEED);&#xA;DBCC CHECKIDENT ('dbo.IstoricRating', RESEED);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DROP + CREATE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C34E2723-3855-4424-A801-3D213F8AACCC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DROP + CREATE"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A93CD923-1C08-4CD2-BA93-F365BA3F44E7}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('dbo.IstoricRating','U') IS NOT NULL DROP TABLE dbo.IstoricRating;&#xA;IF OBJECT_ID('dbo.Ratings','U')       IS NOT NULL DROP TABLE dbo.Ratings;&#xA;IF OBJECT_ID('dbo.Meciuri','U')       IS NOT NULL DROP TABLE dbo.Meciuri;&#xA;IF OBJECT_ID('dbo.Rezervari','U')     IS NOT NULL DROP TABLE dbo.Rezervari;&#xA;IF OBJECT_ID('dbo.Jucatori','U')      IS NOT NULL DROP TABLE dbo.Jucatori;&#xA;IF OBJECT_ID('dbo.Mese','U')          IS NOT NULL DROP TABLE dbo.Mese;&#xA;IF OBJECT_ID('dbo.Cluburi','U')       IS NOT NULL DROP TABLE dbo.Cluburi;&#xA;IF OBJECT_ID('dbo.Orase','U')         IS NOT NULL DROP TABLE dbo.Orase;&#xA;&#xA;CREATE TABLE dbo.Orase (&#xA;    id_oras     INT          NOT NULL PRIMARY KEY,&#xA;    nume_oras   VARCHAR(80)  NOT NULL,&#xA;    judet       VARCHAR(80)  NOT NULL&#xA;);&#xA;&#xA;CREATE TABLE dbo.Cluburi (&#xA;    id_club         INT           NOT NULL PRIMARY KEY,&#xA;    nume            VARCHAR(120)  NOT NULL,&#xA;    id_oras         INT           NOT NULL,&#xA;    adresa          VARCHAR(200)  NULL,&#xA;    telefon         VARCHAR(20)   NULL,&#xA;    ora_deschidere  VARCHAR(5)    NOT NULL,&#xA;    ora_inchidere   VARCHAR(5)    NOT NULL,&#xA;    rating_club     DECIMAL(2,1)  NULL,&#xA;    CONSTRAINT FK_Cluburi_Orase FOREIGN KEY (id_oras) REFERENCES dbo.Orase(id_oras),&#xA;    CONSTRAINT CK_Cluburi_Rating CHECK (rating_club BETWEEN 1.0 AND 5.0)&#xA;);&#xA;&#xA;CREATE TABLE dbo.Mese (&#xA;    id_masa     INT           NOT NULL PRIMARY KEY,&#xA;    id_club     INT           NOT NULL,&#xA;    cod_masa    VARCHAR(10)   NOT NULL,&#xA;    tip_masa    VARCHAR(15)   NOT NULL,&#xA;    tarif_orar  DECIMAL(8,2)  NOT NULL,&#xA;    activa      BIT           NOT NULL,&#xA;    CONSTRAINT FK_Mese_Cluburi FOREIGN KEY (id_club) REFERENCES dbo.Cluburi(id_club),&#xA;    CONSTRAINT UQ_Mese_Club_Cod UNIQUE (id_club, cod_masa),&#xA;    CONSTRAINT CK_Mese_Tip CHECK (tip_masa IN ('pool','snooker','carambol')),&#xA;    CONSTRAINT CK_Mese_Tarif CHECK (tarif_orar &gt; 0)&#xA;);&#xA;&#xA;CREATE TABLE dbo.Jucatori (&#xA;    id_jucator      INT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;    nume            VARCHAR(120)      NOT NULL,&#xA;    email           VARCHAR(150)      NOT NULL UNIQUE,&#xA;    id_oras         INT               NOT NULL,&#xA;    nivel_declarat  INT               NOT NULL,&#xA;    rating_elo      INT               NOT NULL,&#xA;    data_inscriere  DATE              NOT NULL,&#xA;    parola          VARCHAR(30)       NOT NULL,&#xA;    CONSTRAINT FK_Jucatori_Orase FOREIGN KEY (id_oras) REFERENCES dbo.Orase(id_oras),&#xA;    CONSTRAINT CK_Jucatori_Nivel CHECK (nivel_declarat BETWEEN 1 AND 5)&#xA;);&#xA;&#xA;CREATE TABLE dbo.Rezervari (&#xA;    id_rezervare  INT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;    id_masa       INT               NOT NULL,&#xA;    id_jucator    INT               NOT NULL,&#xA;    data_start    DATETIME2(0)      NOT NULL,&#xA;    data_sfarsit  DATETIME2(0)      NOT NULL,&#xA;    status        VARCHAR(15)       NOT NULL,&#xA;    suma          DECIMAL(10,2)     NOT NULL,&#xA;    creata_la     DATETIME2(0)      NOT NULL,&#xA;    CONSTRAINT FK_Rezervari_Mese     FOREIGN KEY (id_masa)    REFERENCES dbo.Mese(id_masa),&#xA;    CONSTRAINT FK_Rezervari_Jucatori FOREIGN KEY (id_jucator) REFERENCES dbo.Jucatori(id_jucator),&#xA;    CONSTRAINT CK_Rezervari_Status   CHECK (status IN ('confirmata','finalizata','anulata','no_show')),&#xA;    CONSTRAINT CK_Rezervari_Interval CHECK (data_sfarsit &gt; data_start),&#xA;    CONSTRAINT CK_Rezervari_Creare   CHECK (creata_la &lt; data_start)&#xA;);&#xA;&#xA;CREATE INDEX IX_Rezervari_Masa_Interval ON dbo.Rezervari (id_masa, data_start, data_sfarsit) INCLUDE (status);&#xA;CREATE INDEX IX_Rezervari_Jucator ON dbo.Rezervari (id_jucator, data_start);&#xA;&#xA;CREATE TABLE dbo.Meciuri (&#xA;    id_meci       INT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;    id_rezervare  INT               NOT NULL UNIQUE,&#xA;    id_jucator_1  INT               NOT NULL,&#xA;    id_jucator_2  INT               NULL,&#xA;    scor_1        INT               NULL,&#xA;    scor_2        INT               NULL,&#xA;    id_castigator INT               NULL,&#xA;    tip           VARCHAR(10)       NOT NULL,&#xA;    stare         VARCHAR(15)       NOT NULL,&#xA;    CONSTRAINT FK_Meciuri_Rezervari  FOREIGN KEY (id_rezervare)  REFERENCES dbo.Rezervari(id_rezervare),&#xA;    CONSTRAINT FK_Meciuri_Jucator1   FOREIGN KEY (id_jucator_1)  REFERENCES dbo.Jucatori(id_jucator),&#xA;    CONSTRAINT FK_Meciuri_Jucator2   FOREIGN KEY (id_jucator_2)  REFERENCES dbo.Jucatori(id_jucator),&#xA;    CONSTRAINT FK_Meciuri_Castigator FOREIGN KEY (id_castigator) REFERENCES dbo.Jucatori(id_jucator),&#xA;    CONSTRAINT CK_Meciuri_Tip   CHECK (tip IN ('privat','deschis')),&#xA;    CONSTRAINT CK_Meciuri_Stare CHECK (stare IN ('finalizat','programat','asteptare','expirat','fara_rezultat')),&#xA;    CONSTRAINT CK_Meciuri_Adversari CHECK (id_jucator_2 IS NULL OR id_jucator_2 &lt;&gt; id_jucator_1),&#xA;    CONSTRAINT CK_Meciuri_Castigator_Valid CHECK (id_castigator IS NULL OR id_castigator IN (id_jucator_1, id_jucator_2))&#xA;);&#xA;&#xA;CREATE INDEX IX_Meciuri_Deschise ON dbo.Meciuri (tip, stare) INCLUDE (id_jucator_1, id_rezervare);&#xA;&#xA;CREATE TABLE dbo.IstoricRating (&#xA;    id_istoric      INT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;    id_jucator      INT               NOT NULL,&#xA;    id_meci         INT               NOT NULL,&#xA;    rating_inainte  INT               NOT NULL,&#xA;    rating_dupa     INT               NOT NULL,&#xA;    data            DATETIME2(0)      NOT NULL,&#xA;    CONSTRAINT FK_Istoric_Jucatori FOREIGN KEY (id_jucator) REFERENCES dbo.Jucatori(id_jucator),&#xA;    CONSTRAINT FK_Istoric_Meciuri  FOREIGN KEY (id_meci)    REFERENCES dbo.Meciuri(id_meci),&#xA;    CONSTRAINT UQ_Istoric_Jucator_Meci UNIQUE (id_jucator, id_meci)&#xA;);&#xA;&#xA;CREATE INDEX IX_Istoric_Jucator_Data ON dbo.IstoricRating (id_jucator, data);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
